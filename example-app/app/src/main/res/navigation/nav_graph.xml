<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.counterproof.HomeFragment">
        <action
            android:id="@+id/action_home_to_details"
            app:destination="@id/detailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.counterproof.DetailsFragment">
        <argument
            android:name="itemId"
            app:argType="string"
            android:defaultValue="0" />
        <!-- String-addressable route for navigate_to_screen (Phase 3):
             navigate(Uri("app://counter/details/42")) lands here. -->
        <deepLink app:uri="app://counter/details/{itemId}" />
    </fragment>
</navigation>
